index 0000000..bc49f2d
--- /dev/null
+++ b/pong/__main__.py
@@ -0,0 +1,81 @@
+"""Curses interface for the Pong game."""
+
+from __future__ import annotations
+
+import curses
+
+from .game import Game
+
+
+def draw(screen: curses.window, game: Game) -> None:
+    """Draw the current game state."""
+    _, columns = screen.getmaxyx()
+    screen.erase()
+    score = f" Left: {game.left_score}    Right: {game.right_score} "
+    screen.addnstr(0, 0, score, max(0, columns - 1))
+
+    top = 1
+    screen.addstr(top, 0, "+" + "-" * game.width + "+")
+    for row in range(game.height):
+        screen_row = top + 1 + row
+        screen.addch(screen_row, 0, "|")
+        screen.addch(screen_row, game.width + 1, "|")
+    screen.addstr(top + game.height + 1, 0, "+" + "-" * game.width + "+")
+
+    for row in range(game.left_paddle.y, game.left_paddle.y + game.left_paddle.height):
+        screen.addch(top + 1 + row, 1 + game.left_paddle_x, "#")
+    for row in range(
+        game.right_paddle.y,
+        game.right_paddle.y + game.right_paddle.height,
+    ):
+        screen.addch(top + 1 + row, 1 + game.right_paddle_x, "#")
+    screen.addch(top + 1 + game.ball.y, 1 + game.ball.x, "O")
+
+    if game.winner is not None:
+        message = f"{game.winner.title()} player wins! Press q to quit."
+        screen.addnstr(top + game.height + 2, 0, message, max(0, columns - 1))
+    screen.refresh()
+
+
+def draw_small_terminal(screen: curses.window) -> None:
+    """Prompt for a larger terminal."""
+    rows, columns = screen.getmaxyx()
+    screen.erase()
+    if rows:
+        message = "Terminal too small for Pong; resize or press q."
+        screen.addnstr(0, 0, message, max(0, columns - 1))
+    screen.refresh()
+
+
+def main(screen: curses.window) -> None:
+    """Run the interactive game loop."""
+    curses.curs_set(0)
+    screen.keypad(True)
+    screen.timeout(80)
+
+    rows, columns = screen.getmaxyx()
+    while rows < 8 or columns < 24:
+        draw_small_terminal(screen)
+        if screen.getch() == ord("q"):
+            return
+        rows, columns = screen.getmaxyx()
+
+    game = Game(width=columns - 2, height=rows - 4, paddle_height=4)
+    while True:
+        draw(screen, game)
+        key = screen.getch()
+        if key == ord("q"):
+            return
+        if key == ord("w"):
+            game.move_paddle("left", "up")
+        elif key == ord("s"):
+            game.move_paddle("left", "down")
+        elif key == curses.KEY_UP:
+            game.move_paddle("right", "up")
+        elif key == curses.KEY_DOWN:
+            game.move_paddle("right", "down")
+        game.step()
+
+
+if __name__ == "__main__":
+    curses.wrapper(main)
