new file mode 100644
index 0000000..b37b1df
--- /dev/null
+++ b/pong/game.py
@@ -0,0 +1,160 @@
+"""Terminal-independent game rules and state for Pong."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass
+class Paddle:
+    """A vertical paddle whose y coordinate is its top row."""
+
+    y: int
+    height: int
+
+    @property
+    def bottom(self) -> int:
+        return self.y + self.height - 1
+
+
+@dataclass
+class Ball:
+    """The ball position and velocity in court coordinates."""
+
+    x: int
+    y: int
+    vx: int
+    vy: int
+
+
+class Game:
+    """A deterministic Pong game that advances one tick at a time."""
+
+    WINNING_SCORE = 5
+
+    def __init__(
+        self,
+        width: int = 40,
+        height: int = 20,
+        paddle_height: int = 4,
+    ) -> None:
+        if width < 5:
+            raise ValueError("width must be at least 5")
+        if height < 2:
+            raise ValueError("height must be at least 2")
+        if not 1 <= paddle_height <= height:
+            raise ValueError("paddle_height must fit inside the court")
+
+        self.width = width
+        self.height = height
+        self.paddle_height = paddle_height
+        paddle_y = (height - paddle_height) // 2
+        self.left_paddle = Paddle(paddle_y, paddle_height)
+        self.right_paddle = Paddle(paddle_y, paddle_height)
+        self.ball = Ball(width // 2, height // 2, 1, 0)
+        self.score = {"left": 0, "right": 0}
+
+    @property
+    def court_size(self) -> tuple[int, int]:
+        return self.width, self.height
+
+    @property
+    def left_paddle_x(self) -> int:
+        return 1
+
+    @property
+    def right_paddle_x(self) -> int:
+        return self.width - 2
+
+    @property
+    def left_score(self) -> int:
+        return self.score["left"]
+
+    @property
+    def right_score(self) -> int:
+        return self.score["right"]
+
+    @property
+    def winner(self) -> str | None:
+        if self.left_score >= self.WINNING_SCORE:
+            return "left"
+        if self.right_score >= self.WINNING_SCORE:
+            return "right"
+        return None
+
+    @property
+    def game_over(self) -> bool:
+        return self.winner is not None
+
+    def move_paddle(self, player: str, direction: int | str) -> None:
+        """Move one paddle one row up or down, clamped to the court."""
+        if self.game_over:
+            return
+        if player == "left":
+            paddle = self.left_paddle
+        elif player == "right":
+            paddle = self.right_paddle
+        else:
+            raise ValueError("player must be 'left' or 'right'")
+
+        if direction in (-1, "up"):
+            delta = -1
+        elif direction in (1, "down"):
+            delta = 1
+        else:
+            raise ValueError("direction must be -1, 1, 'up', or 'down'")
+
+        paddle.y = max(0, min(self.height - paddle.height, paddle.y + delta))
+
+    def step(self) -> None:
+        """Advance the ball once and resolve walls, paddles, and scoring."""
+        if self.game_over:
+            return
+
+        previous_x = self.ball.x
+        self.ball.x += self.ball.vx
+        self.ball.y += self.ball.vy
+        self._bounce_off_walls()
+
+        if self.ball.vx < 0:
+            crossed_paddle = (
+                previous_x >= self.left_paddle_x
+                and self.ball.x <= self.left_paddle_x
+            )
+            if crossed_paddle and self._within_paddle(self.left_paddle):
+                self.ball.x = self.left_paddle_x
+                self.ball.vx = abs(self.ball.vx)
+            elif self.ball.x < self.left_paddle_x:
+                self._score("right", 1)
+        elif self.ball.vx > 0:
+            crossed_paddle = (
+                previous_x <= self.right_paddle_x
+                and self.ball.x >= self.right_paddle_x
+            )
+            if crossed_paddle and self._within_paddle(self.right_paddle):
+                self.ball.x = self.right_paddle_x
+                self.ball.vx = -abs(self.ball.vx)
+            elif self.ball.x > self.right_paddle_x:
+                self._score("left", -1)
+
+    def _within_paddle(self, paddle: Paddle) -> bool:
+        return paddle.y <= self.ball.y <= paddle.bottom
+
+    def _bounce_off_walls(self) -> None:
+        bottom = self.height - 1
+        while self.ball.y < 0 or self.ball.y > bottom:
+            if self.ball.y < 0:
+                self.ball.y = -self.ball.y
+                self.ball.vy = abs(self.ball.vy)
+            else:
+                self.ball.y = 2 * bottom - self.ball.y
+                self.ball.vy = -abs(self.ball.vy)
+
+    def _score(self, player: str, serve_velocity: int) -> None:
+        self.score[player] += 1
+        self.ball = Ball(
+            self.width // 2,
+            self.height // 2,
+            serve_velocity,
+            0,
+        )
