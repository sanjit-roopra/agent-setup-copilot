new file mode 100644
index 0000000..856c61f
--- /dev/null
+++ b/tests/test_game.py
@@ -0,0 +1,124 @@
+import unittest
+
+from pong.game import Game
+
+
+class GameRulesTest(unittest.TestCase):
+    def make_game(self) -> Game:
+        return Game(width=12, height=8, paddle_height=2)
+
+    def test_ball_moves_by_velocity_on_every_step(self) -> None:
+        game = self.make_game()
+        game.ball.x = 5
+        game.ball.y = 3
+        game.ball.vx = 2
+        game.ball.vy = 1
+
+        game.step()
+
+        self.assertEqual((game.ball.x, game.ball.y), (7, 4))
+
+    def test_ball_bounces_at_both_vertical_walls(self) -> None:
+        game = self.make_game()
+        game.ball.x = 5
+        game.ball.y = 0
+        game.ball.vx = 0
+        game.ball.vy = -1
+        game.step()
+        self.assertEqual((game.ball.y, game.ball.vy), (1, 1))
+        self.assertLess(game.ball.y, game.height)
+
+        game.ball.y = game.height - 1
+        game.ball.vy = 1
+        game.step()
+        self.assertEqual((game.ball.y, game.ball.vy), (game.height - 2, -1))
+        self.assertGreaterEqual(game.ball.y, 0)
+
+    def test_ball_bounces_from_each_paddle_when_aligned(self) -> None:
+        game = self.make_game()
+        game.left_paddle.y = 2
+        game.ball.x = game.left_paddle_x + 1
+        game.ball.y = 2
+        game.ball.vx = -1
+        game.ball.vy = 0
+        game.step()
+        self.assertEqual((game.ball.x, game.ball.vx), (game.left_paddle_x, 1))
+
+        game.right_paddle.y = 2
+        game.ball.x = game.right_paddle_x - 1
+        game.ball.y = 3
+        game.ball.vx = 1
+        game.step()
+        self.assertEqual((game.ball.x, game.ball.vx), (game.right_paddle_x, -1))
+
+    def test_passing_a_paddle_scores_and_serves_towards_scorer(self) -> None:
+        game = self.make_game()
+        game.ball.x = game.left_paddle_x
+        game.ball.y = 0
+        game.ball.vx = -1
+        game.step()
+        self.assertEqual(game.right_score, 1)
+        self.assertEqual(
+            (game.ball.x, game.ball.y, game.ball.vx),
+            (game.width // 2, game.height // 2, 1),
+        )
+
+        game.ball.x = game.right_paddle_x
+        game.ball.y = 0
+        game.ball.vx = 1
+        game.step()
+        self.assertEqual(game.left_score, 1)
+        self.assertEqual(
+            (game.ball.x, game.ball.y, game.ball.vx),
+            (game.width // 2, game.height // 2, -1),
+        )
+
+    def test_paddles_move_one_row_and_stop_at_court_edges(self) -> None:
+        game = self.make_game()
+        game.left_paddle.y = 0
+        game.move_paddle("left", "up")
+        self.assertEqual(game.left_paddle.y, 0)
+        game.move_paddle("left", "down")
+        self.assertEqual(game.left_paddle.y, 1)
+
+        bottom = game.height - game.right_paddle.height
+        game.right_paddle.y = bottom
+        game.move_paddle("right", 1)
+        self.assertEqual(game.right_paddle.y, bottom)
+        game.move_paddle("right", -1)
+        self.assertEqual(game.right_paddle.y, bottom - 1)
+
+    def test_game_freezes_after_first_player_reaches_five(self) -> None:
