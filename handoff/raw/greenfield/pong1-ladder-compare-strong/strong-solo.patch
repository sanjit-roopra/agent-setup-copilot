@@ -0,0 +1,111 @@
+"""Pure game rules for Pong."""
+
+from dataclasses import dataclass
+
+
+PADDLE_HEIGHT = 3
+WINNING_SCORE = 5
+
+
+@dataclass
+class Paddle:
+    x: int
+    y: int
+    height: int = PADDLE_HEIGHT
+
+    def move(self, amount: int, court_height: int) -> None:
+        """Move one space in the requested direction, staying on the court."""
+        if amount == 0:
+            return
+        step = 1 if amount > 0 else -1
+        self.y = min(max(self.y + step, 0), court_height - self.height)
+
+    def contains(self, y: int) -> bool:
+        return self.y <= y < self.y + self.height
+
+
+@dataclass
+class Ball:
+    x: int
+    y: int
+    vx: int
+    vy: int
+
+
+class Game:
+    """Mutable Pong state that advances in discrete steps."""
+
+    def __init__(self, width: int = 60, height: int = 20) -> None:
+        if width < 7:
+            raise ValueError("court width must be at least 7")
+        if height < PADDLE_HEIGHT:
+            raise ValueError(f"court height must be at least {PADDLE_HEIGHT}")
+
+        self.width = width
+        self.height = height
+        paddle_y = (height - PADDLE_HEIGHT) // 2
+        self.left_paddle = Paddle(1, paddle_y)
+        self.right_paddle = Paddle(width - 2, paddle_y)
+        self.left_score = 0
+        self.right_score = 0
+        self.ball = Ball(width // 2, height // 2, 1, 1)
+
+    @property
+    def winner(self) -> str | None:
+        if self.left_score >= WINNING_SCORE:
+            return "left"
+        if self.right_score >= WINNING_SCORE:
+            return "right"
+        return None
+
+    def move_left_paddle(self, amount: int) -> None:
+        self.left_paddle.move(amount, self.height)
+
+    def move_right_paddle(self, amount: int) -> None:
+        self.right_paddle.move(amount, self.height)
+
+    def _serve(self, direction: int) -> None:
+        self.ball = Ball(self.width // 2, self.height // 2, direction, 1)
+
+    def _move_ball_vertically(self) -> int:
+        next_y = self.ball.y + self.ball.vy
+        if next_y < 0:
+            next_y = -next_y
+            self.ball.vy = abs(self.ball.vy)
+        elif next_y >= self.height:
+            next_y = 2 * (self.height - 1) - next_y
+            self.ball.vy = -abs(self.ball.vy)
+        return next_y
+
+    def step(self) -> None:
+        """Advance the ball and resolve wall, paddle, score, and win rules."""
+        if self.winner is not None:
+            return
+
+        next_x = self.ball.x + self.ball.vx
+        next_y = self._move_ball_vertically()
+
+        if (
+            self.ball.vx < 0
+            and next_x == self.left_paddle.x
+            and self.left_paddle.contains(next_y)
+        ):
+            self.ball.vx = abs(self.ball.vx)
+        elif (
+            self.ball.vx > 0
+            and next_x == self.right_paddle.x
+            and self.right_paddle.contains(next_y)
+        ):
+            self.ball.vx = -abs(self.ball.vx)
+
+        if next_x < self.left_paddle.x:
+            self.right_score += 1
+            self._serve(-1)
+            return
+        if next_x > self.right_paddle.x:
+            self.left_score += 1
+            self._serve(1)
+            return
+
+        self.ball.x = next_x
+        self.ball.y = next_y
