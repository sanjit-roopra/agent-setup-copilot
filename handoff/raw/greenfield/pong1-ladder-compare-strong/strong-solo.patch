new file mode 100644
index 0000000..fe2d17f
--- /dev/null
+++ b/tests/test_game.py
@@ -0,0 +1,102 @@
+import copy
+import unittest
+
+from pong.game import Ball, Game, WINNING_SCORE
+
+
+class GameTests(unittest.TestCase):
+    def test_ball_moves_by_its_velocity(self) -> None:
+        game = Game()
+        game.ball = Ball(20, 10, 1, -1)
+
+        game.step()
+
+        self.assertEqual((game.ball.x, game.ball.y), (21, 9))
+
+    def test_ball_bounces_off_top_and_bottom_walls(self) -> None:
+        game = Game(height=10)
+
+        game.ball = Ball(20, 0, 1, -1)
+        game.step()
+        self.assertEqual((game.ball.y, game.ball.vy), (1, 1))
+        self.assertGreaterEqual(game.ball.y, 0)
+
+        game.ball = Ball(20, game.height - 1, 1, 1)
+        game.step()
+        self.assertEqual((game.ball.y, game.ball.vy), (game.height - 2, -1))
+        self.assertLess(game.ball.y, game.height)
+
+    def test_ball_bounces_off_each_paddle_within_its_height(self) -> None:
+        game = Game(height=12)
+
+        game.ball = Ball(game.left_paddle.x + 1, game.left_paddle.y + 1, -1, 0)
+        game.step()
+        self.assertEqual(game.ball.x, game.left_paddle.x)
+        self.assertEqual(game.ball.vx, 1)
+
+        game.ball = Ball(game.right_paddle.x - 1, game.right_paddle.y + 1, 1, 0)
+        game.step()
+        self.assertEqual(game.ball.x, game.right_paddle.x)
+        self.assertEqual(game.ball.vx, -1)
+
+    def test_passing_a_paddle_scores_and_serves_toward_conceding_player(self) -> None:
+        game = Game(height=12)
+        centre = (game.width // 2, game.height // 2)
+
+        game.ball = Ball(game.left_paddle.x, 0, -1, 0)
+        game.step()
+        self.assertEqual((game.left_score, game.right_score), (0, 1))
+        self.assertEqual((game.ball.x, game.ball.y), centre)
+        self.assertLess(game.ball.vx, 0)
+
+        game.ball = Ball(game.right_paddle.x, 0, 1, 0)
+        game.step()
+        self.assertEqual((game.left_score, game.right_score), (1, 1))
+        self.assertEqual((game.ball.x, game.ball.y), centre)
+        self.assertGreater(game.ball.vx, 0)
+
+    def test_paddles_move_one_step_and_stay_on_court(self) -> None:
+        game = Game(height=8)
+        starting_left_y = game.left_paddle.y
+        starting_right_y = game.right_paddle.y
+
+        game.move_left_paddle(-20)
+        game.move_right_paddle(20)
+        self.assertEqual(game.left_paddle.y, starting_left_y - 1)
+        self.assertEqual(game.right_paddle.y, starting_right_y + 1)
+
+        for _ in range(20):
+            game.move_left_paddle(-1)
+            game.move_right_paddle(1)
+        self.assertEqual(game.left_paddle.y, 0)
+        self.assertEqual(
+            game.right_paddle.y + game.right_paddle.height,
+            game.height,
+        )
+
+    def test_first_player_to_five_wins_and_step_then_changes_nothing(self) -> None:
+        cases = (
+            ("left", 1),
+            ("right", -1),
+        )
+        for player, direction in cases:
+            with self.subTest(player=player):
+                game = Game(height=12)
+                if player == "left":
+                    game.left_score = WINNING_SCORE - 1
+                    game.ball = Ball(game.right_paddle.x, 0, direction, 0)
+                else:
+                    game.right_score = WINNING_SCORE - 1
+                    game.ball = Ball(game.left_paddle.x, 0, direction, 0)
+
+                game.step()
+
+                self.assertEqual(getattr(game, f"{player}_score"), WINNING_SCORE)
+                self.assertEqual(game.winner, player)
+                completed_state = copy.deepcopy(game.__dict__)
+                game.step()
+                self.assertEqual(game.__dict__, completed_state)
+
+
+if __name__ == "__main__":
+    unittest.main()
