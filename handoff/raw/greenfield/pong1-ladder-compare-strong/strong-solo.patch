index 0000000..7f712d7
--- /dev/null
+++ b/pong/__main__.py
@@ -0,0 +1,65 @@
+"""Curses front end for Pong."""
+
+import curses
+
+from pong.game import Game
+
+
+COURT_WIDTH = 60
+COURT_HEIGHT = 20
+FRAME_DELAY_MS = 75
+
+
+def draw(stdscr: curses.window, game: Game) -> None:
+    stdscr.erase()
+    rows, columns = stdscr.getmaxyx()
+    needed_rows = game.height + 3
+    needed_columns = game.width + 2
+    if rows < needed_rows or columns < needed_columns:
+        message = f"Terminal must be at least {needed_columns}x{needed_rows}; press q to quit"
+        stdscr.addnstr(0, 0, message, max(columns - 1, 0))
+        stdscr.refresh()
+        return
+
+    score = f"{game.left_score}  PONG  {game.right_score}"
+    if game.winner is not None:
+        score += f"   {game.winner.upper()} PLAYER WINS - press q to quit"
+    stdscr.addstr(0, max((needed_columns - len(score)) // 2, 0), score)
+    stdscr.addstr(1, 0, "+" + "-" * game.width + "+")
+    for y in range(game.height):
+        stdscr.addch(y + 2, 0, "|")
+        stdscr.addch(y + 2, game.width + 1, "|")
+    stdscr.addstr(game.height + 2, 0, "+" + "-" * game.width + "+")
+
+    for y in range(game.left_paddle.y, game.left_paddle.y + game.left_paddle.height):
+        stdscr.addch(y + 2, game.left_paddle.x + 1, "|")
+    for y in range(game.right_paddle.y, game.right_paddle.y + game.right_paddle.height):
+        stdscr.addch(y + 2, game.right_paddle.x + 1, "|")
+    stdscr.addch(game.ball.y + 2, game.ball.x + 1, "O")
+    stdscr.refresh()
+
+
+def run(stdscr: curses.window) -> None:
+    curses.curs_set(0)
+    stdscr.keypad(True)
+    stdscr.timeout(FRAME_DELAY_MS)
+    game = Game(COURT_WIDTH, COURT_HEIGHT)
+
+    while True:
+        draw(stdscr, game)
+        key = stdscr.getch()
+        if key in (ord("q"), ord("Q")):
+            return
+        if key in (ord("w"), ord("W")):
+            game.move_left_paddle(-1)
+        elif key in (ord("s"), ord("S")):
+            game.move_left_paddle(1)
+        elif key == curses.KEY_UP:
+            game.move_right_paddle(-1)
+        elif key == curses.KEY_DOWN:
+            game.move_right_paddle(1)
+        game.step()
+
+
+if __name__ == "__main__":
+    curses.wrapper(run)
