+"""Launch Pong with ``python3 -m pong``."""
+
+from __future__ import annotations
+
+import sys
+
+from .terminal import run_game
+
+
+def main() -> int:
+    """Start an interactive match when attached to a terminal."""
+    if not (sys.stdin.isatty() and sys.stdout.isatty()):
+        print("Pong needs an interactive terminal. Run `python3 -m pong` from a terminal.", file=sys.stderr)
+        return 1
+    try:
+        run_game()
+    except KeyboardInterrupt:
+        print()
+        return 130
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
