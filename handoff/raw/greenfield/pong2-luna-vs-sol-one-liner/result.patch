@@ -0,0 +1,53 @@
+import io
+import unittest
+from unittest.mock import patch
+
+from pong.__main__ import main
+from pong.game import PongGame
+from pong.terminal import command_for_key, raw_terminal, render
+
+
+class TerminalTests(unittest.TestCase):
+    def test_commands_cover_both_paddles_and_quit(self):
+        self.assertEqual(command_for_key("w"), ("left", -1))
+        self.assertEqual(command_for_key("s"), ("left", 1))
+        self.assertEqual(command_for_key("\x1b[A"), ("right", -1))
+        self.assertEqual(command_for_key("\x1b[B"), ("right", 1))
+        self.assertEqual(command_for_key("q"), "quit")
+        self.assertEqual(command_for_key("r"), "restart")
+        self.assertIsNone(command_for_key("x"))
+
+    def test_render_contains_board_scores_ball_and_controls(self):
+        game = PongGame(width=12, height=6, paddle_height=2)
+        game.left_score = 2
+        game.right_score = 3
+        frame = render(game)
+
+        self.assertIn("Left: 2", frame)
+        self.assertIn("Right: 3", frame)
+        self.assertIn("●", frame)
+        self.assertIn("W/S", frame)
+        self.assertEqual(frame.count("+" + "-" * game.width + "+"), 2)
+
+    def test_render_can_be_prefixed_for_screen_refresh(self):
+        frame = render(PongGame(width=12, height=6), clear=True)
+        self.assertTrue(frame.startswith("\x1b[2J\x1b[H"))
+
+    def test_raw_terminal_rejects_non_terminal_stream(self):
+        with self.assertRaisesRegex(RuntimeError, "interactive terminal"):
+            with raw_terminal(io.StringIO()):
+                pass
+
+    def test_main_reports_noninteractive_invocation_without_blocking(self):
+        error = io.StringIO()
+        with patch("sys.stdin", io.StringIO()), patch("sys.stdout", io.StringIO()), patch(
+            "sys.stderr", error
+        ):
+            status = main()
+
+        self.assertEqual(status, 1)
+        self.assertIn("interactive terminal", error.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
