+"""Terminal rendering and keyboard input for Pong."""
+
+from __future__ import annotations
+
+import select
+import sys
+import termios
+import time
+import tty
+from contextlib import contextmanager
+from typing import Iterator, TextIO
+
+from .game import PongGame
+
+
+QUIT_KEYS = {"q", "Q", "\x03"}
+COMMANDS = {
+    "w": ("left",  -1),
+    "W": ("left",  -1),
+    "s": ("left", 1),
+    "S": ("left", 1),
+    "\x1b[A": ("right", -1),
+    "\x1b[B": ("right", 1),
+    "i": ("right", -1),
+    "I": ("right", -1),
+    "k": ("right", 1),
+    "K": ("right", 1),
+}
+
+
+def command_for_key(key: str) -> tuple[str, int] | str | None:
+    """Translate a key sequence to a paddle command, restart, quit, or nothing."""
+    if key in QUIT_KEYS:
+        return "quit"
+    if key in {"r", "R"}:
+        return "restart"
+    return COMMANDS.get(key)
+
+
+def render(game: PongGame, clear: bool = False) -> str:
+    """Return a text frame representing the current game state."""
+    board = [[" " for _ in range(game.width)] for _ in range(game.height)]
+    for paddle in (game.left_paddle, game.right_paddle):
+        x = int(paddle.x)
+        start = max(0, int(round(paddle.y)))
+        for y in range(start, min(game.height, start + paddle.height)):
+            board[y][x] = "█"
+
+    ball_x = max(0, min(game.width - 1, int(round(game.ball.x))))
+    ball_y = max(0, min(game.height - 1, int(round(game.ball.y))))
+    board[ball_y][ball_x] = "●"
+
+    lines = [
+        f" PONG     Left: {game.left_score}     Right: {game.right_score}",
+        "+" + "-" * game.width + "+",
+    ]
+    lines.extend("|" + "".join(row) + "|" for row in board)
+    lines.append("+" + "-" * game.width + "+")
+    if game.game_over:
+        lines.append(f" {game.winner.title()} player wins! Press R to restart or Q to quit.")
+    else:
+        lines.append(" W/S: left paddle   I/K or Up/Down: right paddle   Q: quit")
+    frame = "\n".join(lines) + "\n"
+    return "\x1b[2J\x1b[H" + frame if clear else frame
+
+
+def _read_key(stream: TextIO) -> str | None:
+    first = stream.read(1)
+    if not first:
+        return None
+    if first != "\x1b":
+        return first
+    sequence = first
+    for _ in range(2):
+        ready, _, _ = select.select([stream], [], [], 0.01)
+        if not ready:
+            break
+        sequence += stream.read(1)
+    return sequence
+
+
+def _available_keys(stream: TextIO) -> Iterator[str]:
+    ready, _, _ = select.select([stream], [], [], 0)
+    while ready:
+        key = _read_key(stream)
+        if key is None:
+            return
+        yield key
+        ready, _, _ = select.select([stream], [], [], 0)
+
+
+@contextmanager
+def raw_terminal(stream: TextIO) -> Iterator[None]:
+    """Temporarily enable character-at-a-time input and always restore the terminal."""
+    if not stream.isatty():
+        raise RuntimeError("Pong requires an interactive terminal")
+    fd = stream.fileno()
+    original = termios.tcgetattr(fd)
+    try:
+        tty.setcbreak(fd)
+        yield
+    finally:
+        termios.tcsetattr(fd, termios.TCSADRAIN, original)
+
+
+def run_game(
+    game: PongGame | None = None,
+    input_stream: TextIO | None = None,
+    output_stream: TextIO | None = None,
+    frame_delay: float = 0.05,
+    max_frames: int | None = None,
+) -> None:
+    """Run the interactive game until the user quits or a frame limit is reached."""
+    if frame_delay < 0:
+        raise ValueError("frame_delay must not be negative")
+    game = game or PongGame()
+    input_stream = input_stream or sys.stdin
+    output_stream = output_stream or sys.stdout
+    with raw_terminal(input_stream):
+        frame = 0
+        output_stream.write(render(game, clear=True))
+        output_stream.flush()
+        while not game.game_over or max_frames is not None:
+            for key in _available_keys(input_stream):
+                command = command_for_key(key)
+                if command == "quit":
+                    return
+                if command == "restart":
+                    game.reset_match()
+                elif isinstance(command, tuple):
+                    game.move_paddle(*command)
+            if not game.game_over:
+                game.update()
+            frame += 1
+            output_stream.write(render(game, clear=True))
+            output_stream.flush()
+            if max_frames is not None and frame >= max_frames:
+                return
+            time.sleep(frame_delay)
