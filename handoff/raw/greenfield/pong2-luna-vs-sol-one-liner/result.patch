@@ -0,0 +1,63 @@
+import unittest
+
+from pong.game import PongGame
+
+
+class PongGameTests(unittest.TestCase):
+    def test_paddles_are_clamped_to_the_board(self):
+        game = PongGame(width=20, height=10, paddle_height=3)
+
+        game.move_paddle("left", -1, amount=100)
+        self.assertEqual(game.left_paddle.y, 0)
+        game.move_paddle("left", 1, amount=100)
+        self.assertEqual(game.left_paddle.y, 7)
+
+    def test_ball_bounces_from_top_and_bottom_walls(self):
+        game = PongGame(width=20, height=10)
+        game.ball.y = 1
+        game.ball.velocity_y = -2
+        game.update()
+        self.assertEqual(game.ball.y, 0)
+        self.assertEqual(game.ball.velocity_y, 2)
+
+        game.ball.y = 8
+        game.ball.velocity_y = 2
+        game.update()
+        self.assertEqual(game.ball.y, 9)
+        self.assertEqual(game.ball.velocity_y, -2)
+
+    def test_ball_bounces_from_a_paddle(self):
+        game = PongGame(width=20, height=10, paddle_height=3)
+        game.left_paddle.y = 3
+        game.ball.x = 2
+        game.ball.y = 4
+        game.ball.velocity_x = -1
+        game.update()
+        self.assertEqual(game.ball.x, 2)
+        self.assertGreater(game.ball.velocity_x, 0)
+
+    def test_missed_ball_scores_and_starts_a_new_round(self):
+        game = PongGame(width=20, height=10)
+        game.ball.x = 1
+        game.ball.velocity_x = -2
+        game.update()
+        self.assertEqual(game.right_score, 1)
+        self.assertEqual(game.left_score, 0)
+        self.assertEqual(game.ball.x, game.width / 2)
+        self.assertGreater(game.ball.velocity_x, 0)
+
+    def test_winning_score_stops_updates_until_restart(self):
+        game = PongGame(width=20, height=10, winning_score=1)
+        game.right_score = 1
+        game.ball.x = 3
+        game.update()
+        self.assertEqual(game.ball.x, 3)
+        self.assertEqual(game.winner, "right")
+
+        game.reset_match()
+        self.assertFalse(game.game_over)
+        self.assertEqual((game.left_score, game.right_score), (0, 0))
+
+
+if __name__ == "__main__":
+    unittest.main()
