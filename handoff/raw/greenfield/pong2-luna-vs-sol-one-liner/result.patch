+"""Game state and deterministic Pong physics."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass
+class Paddle:
+    """A vertically moving paddle."""
+
+    x: float
+    y: float
+    height: int
+
+    def move(self, direction: int, board_height: int, amount: float = 1.0) -> None:
+        if direction not in (-1, 1):
+            raise ValueError("paddle direction must be -1 or 1")
+        if board_height < self.height:
+            raise ValueError("board must be at least as tall as the paddle")
+        self.y = max(0.0, min(self.y + direction * amount, board_height - self.height))
+
+    @property
+    def center(self) -> float:
+        return self.y + (self.height - 1) / 2
+
+
+@dataclass
+class Ball:
+    """The ball's position and velocity in board coordinates."""
+
+    x: float
+    y: float
+    velocity_x: float
+    velocity_y: float
+
+
+class PongGame:
+    """A two-player Pong match with one update per simulation tick."""
+
+    def __init__(
+        self,
+        width: int = 40,
+        height: int = 20,
+        paddle_height: int = 5,
+        winning_score: int = 7,
+    ) -> None:
+        if width < 10:
+            raise ValueError("board width must be at least 10")
+        if height < 5:
+            raise ValueError("board height must be at least 5")
+        if paddle_height < 1 or paddle_height > height:
+            raise ValueError("paddle height must fit inside the board")
+        if winning_score < 1:
+            raise ValueError("winning score must be positive")
+
+        self.width = width
+        self.height = height
+        self.paddle_height = paddle_height
+        self.winning_score = winning_score
+        paddle_y = (height - paddle_height) / 2
+        self.left_paddle = Paddle(1, paddle_y, paddle_height)
+        self.right_paddle = Paddle(width - 2, paddle_y, paddle_height)
+        self.ball = Ball(width / 2, height / 2, 1.0, 0.0)
+        self.left_score = 0
+        self.right_score = 0
+        self.serve_direction = 1
+
+    @property
+    def game_over(self) -> bool:
+        return self.left_score >= self.winning_score or self.right_score >= self.winning_score
+
+    @property
+    def winner(self) -> str | None:
+        if self.left_score >= self.winning_score:
+            return "left"
+        if self.right_score >= self.winning_score:
+            return "right"
+        return None
+
+    def move_paddle(self, player: str, direction: int, amount: float = 1.0) -> None:
+        """Move a named paddle, clamped to the board."""
+        if player == "left":
+            paddle = self.left_paddle
+        elif player == "right":
+            paddle = self.right_paddle
+        else:
+            raise ValueError("player must be 'left' or 'right'")
+        paddle.move(direction, self.height, amount)
+
+    def reset_match(self) -> None:
+        """Start a new match, clearing both scores and returning paddles to center."""
+        self.left_score = 0
+        self.right_score = 0
+        self._center_paddles()
+        self.reset_round(1)
+
+    def reset_round(self, direction: int | None = None) -> None:
+        """Place the ball at center and serve it in the requested direction."""
+        if direction is not None:
+            if direction not in (-1, 1):
+                raise ValueError("serve direction must be -1 or 1")
+            self.serve_direction = direction
+        self.ball = Ball(self.width / 2, self.height / 2, float(self.serve_direction), 0.0)
+
+    def update(self, ticks: float = 1.0) -> None:
+        """Advance the match by ``ticks`` simulation units."""
+        if ticks <= 0:
+            raise ValueError("ticks must be positive")
+        if self.game_over:
+            return
+
+        ball = self.ball
+        ball.x += ball.velocity_x * ticks
+        ball.y += ball.velocity_y * ticks
+        self._bounce_from_walls()
+        if self._hit_paddle(self.left_paddle, moving_right=False):
+            self._bounce_from_paddle(self.left_paddle, moving_right=True)
+        elif self._hit_paddle(self.right_paddle, moving_right=True):
+            self._bounce_from_paddle(self.right_paddle, moving_right=False)
+        elif ball.x < 0:
+            self.right_score += 1
+            self.reset_round(1)
+        elif ball.x >= self.width:
+            self.left_score += 1
+            self.reset_round(-1)
+
+    def _center_paddles(self) -> None:
+        center = (self.height - self.paddle_height) / 2
+        self.left_paddle.y = center
+        self.right_paddle.y = center
+
+    def _bounce_from_walls(self) -> None:
+        if self.ball.y < 0:
+            self.ball.y = 0
+            self.ball.velocity_y = abs(self.ball.velocity_y)
+        elif self.ball.y >= self.height - 1:
+            self.ball.y = self.height - 1
+            self.ball.velocity_y = -abs(self.ball.velocity_y)
+
+    def _hit_paddle(self, paddle: Paddle, moving_right: bool) -> bool:
+        if moving_right and self.ball.velocity_x <= 0:
+            return False
+        if not moving_right and self.ball.velocity_x >= 0:
+            return False
+        paddle_face = paddle.x + 1 if moving_right else paddle.x
+        within_face = self.ball.x <= paddle_face if moving_right else self.ball.x >= paddle_face
+        within_depth = (
+            self.ball.x >= paddle.x - 1
+            if moving_right
+            else self.ball.x <= paddle.x + 1
+        )
+        within_height = paddle.y - 0.5 <= self.ball.y <= paddle.y + paddle.height - 0.5
+        return within_face and within_depth and within_height
+
+    def _bounce_from_paddle(self, paddle: Paddle, moving_right: bool) -> None:
+        offset = (self.ball.y - paddle.center) / max(1.0, paddle.height / 2)
+        self.ball.velocity_y = offset * 1.5
+        speed = max(1.0, abs(self.ball.velocity_x))
+        self.ball.velocity_x = speed if moving_right else -speed
+        self.ball.x = paddle.x + 1 if moving_right else paddle.x
