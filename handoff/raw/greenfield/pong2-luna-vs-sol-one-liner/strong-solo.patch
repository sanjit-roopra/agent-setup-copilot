+"""Game state and rules for Pong."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Literal
+
+
+@dataclass
+class Paddle:
+    x: int
+    y: float
+    height: int
+
+    def move(self, distance: float, board_height: int) -> None:
+        self.y = min(max(self.y + distance, 0.0), board_height - self.height)
+
+    def contains(self, y: float) -> bool:
+        return self.y <= y <= self.y + self.height - 1
+
+
+@dataclass
+class Ball:
+    x: float
+    y: float
+    vx: float
+    vy: float
+
+
+@dataclass
+class GameState:
+    width: int = 60
+    height: int = 20
+    paddle_height: int = 5
+    winning_score: int = 7
+    left: Paddle = field(init=False)
+    right: Paddle = field(init=False)
+    ball: Ball = field(init=False)
+    left_score: int = field(default=0, init=False)
+    right_score: int = field(default=0, init=False)
+
+    def __post_init__(self) -> None:
+        if self.width < 20 or self.height < 8:
+            raise ValueError("the board must be at least 20 columns by 8 rows")
+        if not 2 <= self.paddle_height < self.height:
+            raise ValueError("paddle height must fit within the board")
+        if self.winning_score < 1:
+            raise ValueError("winning score must be positive")
+
+        paddle_y = (self.height - self.paddle_height) / 2
+        self.left = Paddle(1, paddle_y, self.paddle_height)
+        self.right = Paddle(self.width - 2, paddle_y, self.paddle_height)
+        self.reset_ball(direction=1)
+
+    @property
+    def winner(self) -> str | None:
+        if self.left_score >= self.winning_score:
+            return "Left"
+        if self.right_score >= self.winning_score:
+            return "Right"
+        return None
+
+    def move_paddle(
+        self, player: Literal["left", "right"], direction: int, amount: float = 2.0
+    ) -> None:
+        if player not in ("left", "right"):
+            raise ValueError(f"unknown player: {player}")
+        paddle = self.left if player == "left" else self.right
+        paddle.move(direction * amount, self.height)
+
+    def reset_ball(self, direction: int) -> None:
+        if direction not in (-1, 1):
+            raise ValueError("ball direction must be -1 or 1")
+        self.ball = Ball(
+            x=(self.width - 1) / 2,
+            y=(self.height - 1) / 2,
+            vx=direction * 18.0,
+            vy=7.0,
+        )
+
+    def restart(self) -> None:
+        self.left_score = 0
+        self.right_score = 0
+        paddle_y = (self.height - self.paddle_height) / 2
+        self.left.y = paddle_y
+        self.right.y = paddle_y
+        self.reset_ball(direction=1)
+
+    def step(self, seconds: float) -> None:
+        if seconds < 0:
+            raise ValueError("elapsed time cannot be negative")
+        if self.winner or seconds == 0:
+            return
+
+        previous_x = self.ball.x
+        self.ball.x += self.ball.vx * seconds
+        self.ball.y += self.ball.vy * seconds
+        self._bounce_off_walls()
+        self._bounce_off_paddles(previous_x)
+
+        if self.ball.x < 0:
+            self.right_score += 1
+            self.reset_ball(direction=-1)
+        elif self.ball.x >= self.width:
+            self.left_score += 1
+            self.reset_ball(direction=1)
+
+    def _bounce_off_walls(self) -> None:
+        bottom = self.height - 1
+        if self.ball.y < 0:
+            self.ball.y = -self.ball.y
+            self.ball.vy = abs(self.ball.vy)
+        elif self.ball.y > bottom:
+            self.ball.y = 2 * bottom - self.ball.y
+            self.ball.vy = -abs(self.ball.vy)
+
+    def _bounce_off_paddles(self, previous_x: float) -> None:
+        if (
+            self.ball.vx < 0
+            and previous_x >= self.left.x
+            and self.ball.x <= self.left.x
+            and self.left.contains(self.ball.y)
+        ):
+            self.ball.x = self.left.x + 1
+            self.ball.vx = abs(self.ball.vx)
+            self._add_paddle_deflection(self.left)
+        elif (
+            self.ball.vx > 0
+            and previous_x <= self.right.x
+            and self.ball.x >= self.right.x
+            and self.right.contains(self.ball.y)
+        ):
+            self.ball.x = self.right.x - 1
+            self.ball.vx = -abs(self.ball.vx)
+            self._add_paddle_deflection(self.right)
+
+    def _add_paddle_deflection(self, paddle: Paddle) -> None:
+        paddle_center = paddle.y + (paddle.height - 1) / 2
+        offset = (self.ball.y - paddle_center) / max(1, paddle.height - 1)
+        self.ball.vy += offset * 8.0
