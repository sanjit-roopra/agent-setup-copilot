@@ -0,0 +1,85 @@
+import unittest
+
+from pong.game import GameState
+
+
+class GameStateTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.game = GameState(width=30, height=12, paddle_height=4, winning_score=2)
+
+    def test_paddle_movement_stays_inside_board(self) -> None:
+        self.game.move_paddle("left", -1, amount=100)
+        self.game.move_paddle("right", 1, amount=100)
+
+        self.assertEqual(self.game.left.y, 0)
+        self.assertEqual(self.game.right.y, 8)
+
+    def test_ball_collision_with_top_wall_reflects_down(self) -> None:
+        self.game.ball.y = 0.2
+        self.game.ball.vy = -10
+
+        self.game.step(0.1)
+
+        self.assertGreaterEqual(self.game.ball.y, 0)
+        self.assertGreater(self.game.ball.vy, 0)
+
+    def test_ball_collision_with_left_paddle_reflects_right(self) -> None:
+        self.game.ball.x = 2
+        self.game.ball.y = self.game.left.y + 1
+        self.game.ball.vx = -10
+        self.game.ball.vy = 0
+
+        self.game.step(0.1)
+
+        self.assertGreater(self.game.ball.vx, 0)
+        self.assertEqual(self.game.ball.x, self.game.left.x + 1)
+
+    def test_ball_collision_with_right_paddle_reflects_left(self) -> None:
+        self.game.ball.x = self.game.right.x - 1
+        self.game.ball.y = self.game.right.y + 1
+        self.game.ball.vx = 10
+        self.game.ball.vy = 0
+
+        self.game.step(0.1)
+
+        self.assertLess(self.game.ball.vx, 0)
+        self.assertEqual(self.game.ball.x, self.game.right.x - 1)
+
+    def test_missed_ball_increases_score_and_resets_ball(self) -> None:
+        self.game.ball.x = 0.1
+        self.game.ball.y = 0
+        self.game.ball.vx = -10
+
+        self.game.step(0.1)
+
+        self.assertEqual(self.game.right_score, 1)
+        self.assertEqual(self.game.ball.x, (self.game.width - 1) / 2)
+        self.assertLess(self.game.ball.vx, 0)
+
+    def test_winning_score_stops_ball(self) -> None:
+        self.game.right_score = self.game.winning_score
+        before = (self.game.ball.x, self.game.ball.y)
+
+        self.game.step(1)
+
+        self.assertEqual(self.game.winner, "Right")
+        self.assertEqual((self.game.ball.x, self.game.ball.y), before)
+
+    def test_restart_resets_scores_paddles_and_ball(self) -> None:
+        self.game.left_score = 1
+        self.game.right_score = 2
+        self.game.left.y = 0
+
+        self.game.restart()
+
+        self.assertEqual((self.game.left_score, self.game.right_score), (0, 0))
+        self.assertEqual(self.game.left.y, 4)
+        self.assertEqual(self.game.ball.x, (self.game.width - 1) / 2)
+
+    def test_invalid_dimensions_are_rejected(self) -> None:
+        with self.assertRaises(ValueError):
+            GameState(width=10)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_terminal.py b/tests/test_terminal.py
new file mode 100644
index 0000000..82a8a11
