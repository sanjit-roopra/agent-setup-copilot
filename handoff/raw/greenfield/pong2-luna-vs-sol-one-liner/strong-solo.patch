+"""Terminal rendering and keyboard controls for Pong."""
+
+from __future__ import annotations
+
+import os
+import select
+import shutil
+import sys
+import time
+from typing import TextIO
+
+from .game import GameState
+
+
+FRAME_SECONDS = 1 / 30
+
+
+class Controls:
+    def __init__(self, stream: TextIO | None = None) -> None:
+        self.stream = stream or sys.stdin
+        self._file_descriptor: int | None = None
+        self._settings: object | None = None
+
+    def __enter__(self) -> Controls:
+        if not self.stream.isatty():
+            raise RuntimeError("keyboard input must be connected to a terminal")
+        self._file_descriptor = self.stream.fileno()
+        if os.name != "nt":
+            import termios
+            import tty
+
+            self._settings = termios.tcgetattr(self._file_descriptor)
+            tty.setcbreak(self._file_descriptor)
+        return self
+
+    def __exit__(self, *exc_info: object) -> None:
+        if os.name != "nt" and self._file_descriptor is not None and self._settings is not None:
+            import termios
+
+            termios.tcsetattr(
+                self._file_descriptor, termios.TCSADRAIN, self._settings
+            )
+
+    def read(self) -> str:
+        if os.name == "nt":
+            return self._read_windows()
+        if self._file_descriptor is None:
+            raise RuntimeError("controls must be used as a context manager")
+
+        chunks: list[bytes] = []
+        while select.select([self._file_descriptor], [], [], 0)[0]:
+            chunks.append(os.read(self._file_descriptor, 32))
+        return b"".join(chunks).decode(errors="ignore")
+
+    @staticmethod
+    def _read_windows() -> str:
+        import msvcrt
+
+        keys: list[str] = []
+        while msvcrt.kbhit():
+            key = msvcrt.getwch()
+            if key in ("\x00", "\xe0"):
+                special = msvcrt.getwch()
+                key = {"H": "\x1b[A", "P": "\x1b[B"}.get(special, "")
+            keys.append(key)
+        return "".join(keys)
+
+
+def handle_input(keys: str, game: GameState) -> bool:
+    lowered = keys.lower()
+    if "q" in lowered:
+        return False
+
+    for _ in range(lowered.count("w")):
+        game.move_paddle("left", -1)
+    for _ in range(lowered.count("s")):
+        game.move_paddle("left", 1)
+    for _ in range(keys.count("\x1b[A")):
+        game.move_paddle("right", -1)
+    for _ in range(keys.count("\x1b[B")):
+        game.move_paddle("right", 1)
+    return True
+
+
+def render(game: GameState) -> str:
+    cells = [[" " for _ in range(game.width)] for _ in range(game.height)]
+    for y in range(game.height):
+        if y % 2 == 0:
+            cells[y][game.width // 2] = ":"
+
+    for paddle in (game.left, game.right):
+        top = round(paddle.y)
+        for y in range(top, min(top + paddle.height, game.height)):
+            cells[y][paddle.x] = "|"
+
+    ball_x = round(game.ball.x)
+    ball_y = round(game.ball.y)
+    if 0 <= ball_x < game.width and 0 <= ball_y < game.height:
+        cells[ball_y][ball_x] = "O"
+
+    score = f"Left {game.left_score}  -  {game.right_score} Right"
+    lines = ["\x1b[H" + score.center(game.width + 2), "+" + "-" * game.width + "+"]
+    lines.extend("|" + "".join(row) + "|" for row in cells)
+    lines.append("+" + "-" * game.width + "+")
+    lines.append("W/S: left  Up/Down: right  Q: quit")
+    return "\n".join(lines)
+
+
+def run_game(
+    input_stream: TextIO | None = None, output_stream: TextIO | None = None
+) -> None:
+    input_stream = input_stream or sys.stdin
+    output_stream = output_stream or sys.stdout
+    if not output_stream.isatty():
+        raise RuntimeError("output must be connected to a terminal")
+
+    columns, lines = shutil.get_terminal_size()
+    if columns < 32 or lines < 14:
+        raise RuntimeError("terminal must be at least 32 columns by 14 rows")
+
+    game = GameState(width=min(60, columns - 2), height=min(20, lines - 4))
+    with Controls(input_stream) as controls:
+        output_stream.write("\x1b[2J\x1b[?25l")
+        output_stream.flush()
+        previous = time.monotonic()
+        try:
+            while game.winner is None:
+                frame_started = time.monotonic()
+                if not handle_input(controls.read(), game):
+                    break
+                game.step(min(frame_started - previous, 0.05))
+                previous = frame_started
+                output_stream.write(render(game))
+                output_stream.flush()
+                delay = FRAME_SECONDS - (time.monotonic() - frame_started)
+                if delay > 0:
+                    time.sleep(delay)
+            if game.winner is not None:
+                output_stream.write(render(game) + f"\n{game.winner} player wins!")
+                output_stream.flush()
+        finally:
+            output_stream.write("\x1b[?25h\n")
+            output_stream.flush()
