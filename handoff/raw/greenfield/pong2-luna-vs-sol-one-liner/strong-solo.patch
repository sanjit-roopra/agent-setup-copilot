+"""Command-line entry point for ``python3 -m pong``."""
+
+import sys
+
+from .terminal import run_game
+
+
+def main() -> int:
+    try:
+        run_game()
+    except RuntimeError as error:
+        print(f"pong: {error}", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
