+++ b/tests/test_terminal.py
@@ -0,0 +1,80 @@
+import io
+import unittest
+from unittest import mock
+
+from pong import __main__ as entrypoint
+from pong.game import GameState
+from pong.terminal import Controls, handle_input, render, run_game
+
+
+class TerminalBuffer(io.StringIO):
+    def isatty(self) -> bool:
+        return True
+
+
+class TerminalTests(unittest.TestCase):
+    def test_render_includes_board_ball_paddles_score_and_controls(self) -> None:
+        game = GameState(width=30, height=10)
+
+        screen = render(game)
+
+        self.assertIn("Left 0  -  0 Right", screen)
+        self.assertIn("O", screen)
+        self.assertIn("|", screen)
+        self.assertIn("W/S: left", screen)
+        self.assertEqual(screen.count("\n"), game.height + 3)
+
+    def test_controls_move_both_paddles(self) -> None:
+        game = GameState(width=30, height=10)
+        left_before = game.left.y
+        right_before = game.right.y
+
+        keep_playing = handle_input("w\x1b[B", game)
+
+        self.assertTrue(keep_playing)
+        self.assertLess(game.left.y, left_before)
+        self.assertGreater(game.right.y, right_before)
+
+    def test_q_quits(self) -> None:
+        self.assertFalse(handle_input("q", GameState()))
+
+    def test_controls_reject_non_terminal_input(self) -> None:
+        with self.assertRaises(RuntimeError):
+            Controls(io.StringIO()).__enter__()
+
+    @mock.patch("pong.terminal.shutil.get_terminal_size", return_value=(80, 24))
+    @mock.patch("pong.terminal.Controls")
+    def test_run_game_restores_cursor_when_quitting(
+        self, controls_type: mock.Mock, _terminal_size: mock.Mock
+    ) -> None:
+        controls_type.return_value.__enter__.return_value.read.return_value = "q"
+        output = TerminalBuffer()
+
+        run_game(TerminalBuffer(), output)
+
+        self.assertIn("\x1b[?25l", output.getvalue())
+        self.assertTrue(output.getvalue().endswith("\x1b[?25h\n"))
+
+    def test_python_module_entrypoint_delegates_to_run_game(self) -> None:
+        with mock.patch.object(entrypoint, "run_game") as run:
+            result = entrypoint.main()
+
+        self.assertEqual(result, 0)
+        run.assert_called_once_with()
+
+    def test_python_module_entrypoint_reports_terminal_errors(self) -> None:
+        error_output = io.StringIO()
+        with (
+            mock.patch.object(
+                entrypoint, "run_game", side_effect=RuntimeError("not a terminal")
+            ),
+            mock.patch("sys.stderr", error_output),
+        ):
+            result = entrypoint.main()
+
+        self.assertEqual(result, 1)
+        self.assertIn("not a terminal", error_output.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
