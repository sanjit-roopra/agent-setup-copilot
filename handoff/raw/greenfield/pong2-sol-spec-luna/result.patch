+    def read_keys(self):
+        if self.fail_on_read:
+            raise RuntimeError("read failed")
+        return self.keys.pop(0) if self.keys else "q"
+
+    def write(self, text):
+        self.writes.append(text)
+
+    def monotonic(self):
+        return self.now
+
+    def sleep(self, seconds):
+        self.sleeps.append(seconds)
+        self.now += seconds
