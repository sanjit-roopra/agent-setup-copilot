new file mode 100644
index 0000000..c246f71
--- /dev/null
+++ b/pong/core.py
@@ -0,0 +1,275 @@
+from dataclasses import dataclass, replace
+from enum import Enum
+from math import ceil, floor
+
+
+SCREEN_WIDTH = 80
+SCREEN_HEIGHT = 24
+COURT_WIDTH = 80
+COURT_HEIGHT = 22
+LEFT_PADDLE_X = 2
+RIGHT_PADDLE_X = 77
+PADDLE_HEIGHT = 5
+PADDLE_SPEED = 1
+BALL_HORIZONTAL_SPEED = 0.5
+BALL_INITIAL_VERTICAL_SPEED = 0.3
+BALL_DEFLECT_SPEED = 0.5
+TICK_RATE = 30
+TICK_SECONDS = 1 / TICK_RATE
+SERVE_TICKS = 30
+WINNING_SCORE = 5
+MAX_CATCH_UP_TICKS = 5
+
+
+class Side(str, Enum):
+    LEFT = "left"
+    RIGHT = "right"
+
+
+class Phase(str, Enum):
+    SERVE = "serve"
+    PLAYING = "playing"
+    GAME_OVER = "game_over"
+
+
+@dataclass(frozen=True)
+class Controls:
+    left_move: int = 0
+    right_move: int = 0
+    toggle_pause: bool = False
+    restart: bool = False
+    quit: bool = False
+
+    def __post_init__(self) -> None:
+        if type(self.left_move) is not int or self.left_move not in (-1, 0, 1):
+            raise ValueError("left_move must be -1, 0, or 1")
+        if type(self.right_move) is not int or self.right_move not in (-1, 0, 1):
+            raise ValueError("right_move must be -1, 0, or 1")
+
+
+@dataclass(frozen=True)
+class GameState:
+    left_paddle_y: int
+    right_paddle_y: int
+    ball_x: float
+    ball_y: float
+    ball_vx: float
+    ball_vy: float
+    left_score: int
+    right_score: int
+    phase: Phase
+    serve_ticks_remaining: int
+    serve_direction: Side
+    paused: bool
+    winner: Side | None
+    tick: int
+    points_played: int
+
+
+def initial_state() -> GameState:
+    return GameState(
+        8,
+        8,
+        39.5,
+        10.5,
+        0.0,
+        0.0,
+        0,
+        0,
+        Phase.SERVE,
+        SERVE_TICKS,
+        Side.RIGHT,
+        False,
+        None,
+        0,
+        0,
+    )
+
+
+def parse_keys(keys: str) -> Controls:
+    lowered = keys.casefold()
+    left_up = "w" in lowered
+    left_down = "s" in lowered
+    right_up = "o" in lowered
+    right_down = "l" in lowered
+    return Controls(
+        left_move=0 if left_up and left_down else (-1 if left_up else 1 if left_down else 0),
+        right_move=0 if right_up and right_down else (-1 if right_up else 1 if right_down else 0),
+        toggle_pause=lowered.count(" ") % 2 == 1,
+        restart="r" in lowered,
+        quit="q" in lowered or "\x03" in keys,
+    )
+
+
+def _paddle_y(value: int, move: int) -> int:
+    return max(1, min(16, value + move * PADDLE_SPEED))
+
+
+def _deflection_y(relative_y: float) -> float:
+    if relative_y < PADDLE_HEIGHT / 3:
+        return -BALL_DEFLECT_SPEED
+    if relative_y < (PADDLE_HEIGHT * 2) / 3:
+        return 0.0
+    return BALL_DEFLECT_SPEED
+
+
+def advance(state: GameState, controls: Controls = Controls()) -> GameState:
+    if controls.restart:
+        return initial_state()
+    if state.phase is Phase.GAME_OVER:
+        return state
+    if controls.toggle_pause:
+        return replace(state, paused=not state.paused)
+    if state.paused:
+        return state
+
+    left_paddle_y = _paddle_y(state.left_paddle_y, controls.left_move)
+    right_paddle_y = _paddle_y(state.right_paddle_y, controls.right_move)
+    tick = state.tick + 1
+
+    if state.phase is Phase.SERVE:
+        remaining = state.serve_ticks_remaining - 1
+        if remaining > 0:
+            return replace(
+                state,
+                left_paddle_y=left_paddle_y,
+                right_paddle_y=right_paddle_y,
+                ball_x=39.5,
+                ball_y=10.5,
+                ball_vx=0.0,
+                ball_vy=0.0,
+                serve_ticks_remaining=remaining,
+                tick=tick,
+            )
+        return replace(
+            state,
+            left_paddle_y=left_paddle_y,
+            right_paddle_y=right_paddle_y,
+            ball_x=39.5,
+            ball_y=10.5,
+            ball_vx=BALL_HORIZONTAL_SPEED
+            if state.serve_direction is Side.RIGHT
+            else -BALL_HORIZONTAL_SPEED,
+            ball_vy=BALL_INITIAL_VERTICAL_SPEED
+            if state.points_played % 2 == 0
+            else -BALL_INITIAL_VERTICAL_SPEED,
+            phase=Phase.PLAYING,
+            serve_ticks_remaining=0,
+            tick=tick,
+        )
+
+    old_x = state.ball_x
+    candidate_x = state.ball_x + state.ball_vx
+    candidate_y = state.ball_y + state.ball_vy
+    ball_vy = state.ball_vy
+
+    if candidate_y < 1:
+        candidate_y = 2 - candidate_y
+        ball_vy = abs(ball_vy)
+    elif candidate_y > 20:
+        candidate_y = 40 - candidate_y
+        ball_vy = -abs(ball_vy)
+
+    if (
+        state.ball_vx < 0
+        and old_x > 3
+        and candidate_x <= 3
+        and left_paddle_y <= candidate_y < left_paddle_y + PADDLE_HEIGHT
+    ):
+        candidate_x = 6 - candidate_x
+        ball_vx = BALL_HORIZONTAL_SPEED
+        ball_vy = _deflection_y(candidate_y - left_paddle_y)
+    elif (
+        state.ball_vx > 0
+        and old_x < 76
+        and candidate_x >= 76
+        and right_paddle_y <= candidate_y < right_paddle_y + PADDLE_HEIGHT
+    ):
+        candidate_x = 152 - candidate_x
+        ball_vx = -BALL_HORIZONTAL_SPEED
+        ball_vy = _deflection_y(candidate_y - right_paddle_y)
+    else:
+        ball_vx = state.ball_vx
+
+    if candidate_x < 0 or candidate_x > 79:
+        left_score = state.left_score
+        right_score = state.right_score
+        if candidate_x < 0:
+            right_score += 1
+            serve_direction = Side.LEFT
+            winner = Side.RIGHT
+        else:
+            left_score += 1
+            serve_direction = Side.RIGHT
+            winner = Side.LEFT
+        points_played = state.points_played + 1
+        phase = Phase.GAME_OVER if max(left_score, right_score) >= WINNING_SCORE else Phase.SERVE
+        return replace(
+            state,
+            left_paddle_y=left_paddle_y,
+            right_paddle_y=right_paddle_y,
+            ball_x=39.5,
+            ball_y=10.5,
+            ball_vx=0.0,
+            ball_vy=0.0,
+            left_score=left_score,
+            right_score=right_score,
+            phase=phase,
+            serve_ticks_remaining=0 if phase is Phase.GAME_OVER else SERVE_TICKS,
+            serve_direction=serve_direction,
+            winner=winner if phase is Phase.GAME_OVER else None,
+            tick=tick,
+            points_played=points_played,
+        )
+
+    return replace(
+        state,
+        left_paddle_y=left_paddle_y,
+        right_paddle_y=right_paddle_y,
+        ball_x=candidate_x,
+        ball_y=candidate_y,
+        ball_vx=ball_vx,
+        ball_vy=ball_vy,
+        tick=tick,
+    )
+
+
+def render(state: GameState) -> str:
+    if state.paused:
+        phase_text = "PAUSED"
+    elif state.phase is Phase.SERVE:
+        phase_text = f"SERVE {ceil(state.serve_ticks_remaining / SERVE_TICKS)}s"
+    elif state.phase is Phase.PLAYING:
+        phase_text = "PLAY"
+    else:
+        phase_text = f"{state.winner.name} WINS - R TO RESTART"
+
+    status = f"Left {state.left_score}  Right {state.right_score}  {phase_text}".center(
+        SCREEN_WIDTH
+    )
+    court = []
+    ball_column = floor(state.ball_x + 0.5)
+    ball_row = floor(state.ball_y + 0.5)
+    for row in range(COURT_HEIGHT):
+        if row in (0, COURT_HEIGHT - 1):
+            line = ["+"] + ["-"] * (COURT_WIDTH - 2) + ["+"]
+        else:
+            line = [" "] * COURT_WIDTH
+            line[0] = "|"
+            line[-1] = "|"
+            if state.left_paddle_y <= row < state.left_paddle_y + PADDLE_HEIGHT:
+                line[LEFT_PADDLE_X] = "|"
+            if state.right_paddle_y <= row < state.right_paddle_y + PADDLE_HEIGHT:
+                line[RIGHT_PADDLE_X] = "|"
+        if (
+            row == ball_row
+            and 0 <= ball_row < COURT_HEIGHT
+            and 0 <= ball_column < COURT_WIDTH
+        ):
+            line[ball_column] = "o"
+        court.append("".join(line))
+
+    controls = "W/S: left  O/L: right  SPACE: pause  R: restart  Q: quit".center(
+        SCREEN_WIDTH
+    )
+    return "\n".join([status, *court, controls])
