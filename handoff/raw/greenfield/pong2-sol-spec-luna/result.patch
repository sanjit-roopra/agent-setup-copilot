@@ -0,0 +1,140 @@
+import fcntl
+import os
+import select
+import shutil
+import sys
+import termios
+import tty
+from time import monotonic, sleep
+from typing import Protocol
+
+from .core import (
+    MAX_CATCH_UP_TICKS,
+    SCREEN_HEIGHT,
+    SCREEN_WIDTH,
+    TICK_SECONDS,
+    Controls,
+    advance,
+    initial_state,
+    parse_keys,
+    render,
+)
+
+
+class Terminal(Protocol):
+    def get_size(self) -> tuple[int, int]:
+        ...
+
+    def enter(self) -> None:
+        ...
+
+    def restore(self) -> None:
+        ...
+
+    def read_keys(self) -> str:
+        ...
+
+    def write(self, text: str) -> None:
+        ...
+
+    def monotonic(self) -> float:
+        ...
+
+    def sleep(self, seconds: float) -> None:
+        ...
+
+
+class SystemTerminal:
+    def __init__(self) -> None:
+        self._fd: int | None = None
+        self._old_attrs = None
+        self._old_flags: int | None = None
+
+    def get_size(self) -> tuple[int, int]:
+        size = shutil.get_terminal_size(fallback=(0, 0))
+        return size.columns, size.lines
+
+    def enter(self) -> None:
+        self._fd = sys.stdin.fileno()
+        self._old_flags = fcntl.fcntl(self._fd, fcntl.F_GETFL)
+        fcntl.fcntl(self._fd, fcntl.F_SETFL, self._old_flags | os.O_NONBLOCK)
+        if os.isatty(self._fd):
+            self._old_attrs = termios.tcgetattr(self._fd)
+            tty.setcbreak(self._fd)
+
+    def restore(self) -> None:
+        if self._fd is None:
+            return
+        if self._old_attrs is not None:
+            termios.tcsetattr(self._fd, termios.TCSADRAIN, self._old_attrs)
+        if self._old_flags is not None:
+            fcntl.fcntl(self._fd, fcntl.F_SETFL, self._old_flags)
+        self._fd = None
+        self._old_attrs = None
+        self._old_flags = None
+
+    def read_keys(self) -> str:
+        if self._fd is None:
+            raise RuntimeError("terminal is not entered")
+        readable, _, _ = select.select([self._fd], [], [], 0)
+        if not readable:
+            return ""
+        data = os.read(self._fd, 4096)
+        if not data:
+            raise EOFError
+        return data.decode("ascii", errors="ignore")
+
+    def write(self, text: str) -> None:
+        sys.stdout.write(text)
+        sys.stdout.flush()
+
+    def monotonic(self) -> float:
+        return monotonic()
+
+    def sleep(self, seconds: float) -> None:
+        sleep(seconds)
+
+
+def run(terminal: Terminal | None = None) -> int:
+    if terminal is None:
+        terminal = SystemTerminal()
+    columns, rows = terminal.get_size()
+    if columns < SCREEN_WIDTH or rows < SCREEN_HEIGHT:
+        terminal.write("Pong requires a terminal of at least 80 columns by 24 rows.\n")
+        return 1
+
+    try:
+        terminal.enter()
+        terminal.write("\x1b[2J\x1b[?25l")
+        state = initial_state()
+        terminal.write("\x1b[H" + render(state))
+        next_tick = terminal.monotonic() + TICK_SECONDS
+        pending_keys = ""
+
+        while True:
+            controls = parse_keys(pending_keys)
+            if controls.quit:
+                return 0
+
+            now = terminal.monotonic()
+            updates = 0
+            while now >= next_tick and updates < MAX_CATCH_UP_TICKS:
+                state = advance(state, controls if updates == 0 else Controls())
+                updates += 1
+                next_tick += TICK_SECONDS
+
+            if updates:
+                pending_keys = ""
+                if now >= next_tick:
+                    next_tick = now + TICK_SECONDS
+                terminal.write("\x1b[H" + render(state))
+
+            pending_keys += terminal.read_keys()
+            if parse_keys(pending_keys).quit:
+                return 0
+            terminal.sleep(max(0.0, next_tick - terminal.monotonic()))
+    except (EOFError, KeyboardInterrupt):
+        return 0
+    finally:
+        terminal.write("\x1b[?25h\n")
+        terminal.restore()
