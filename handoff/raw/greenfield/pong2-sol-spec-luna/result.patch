+        self.size = size
+        self.fail_on_read = fail_on_read
+        self.enter_count = 0
+        self.restore_count = 0
+        self.writes = []
+        self.sleeps = []
+        self.now = 0.0
+
+    def get_size(self):
+        return self.size
+
+    def enter(self):
+        self.enter_count += 1
+
+    def restore(self):
+        self.restore_count += 1
