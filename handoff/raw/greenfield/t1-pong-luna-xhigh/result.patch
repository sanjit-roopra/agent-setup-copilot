@@ -0,0 +1,79 @@
+import unittest
+
+from pong.game import Ball, Game, GameConfig
+
+
+class GameConfigTests(unittest.TestCase):
+    def test_rejects_unplayable_dimensions(self) -> None:
+        with self.assertRaises(ValueError):
+            GameConfig(width=10)
+        with self.assertRaises(ValueError):
+            GameConfig(height=7)
+        with self.assertRaises(ValueError):
+            GameConfig(paddle_height=0)
+
+
+class GameTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.game = Game(GameConfig(width=20, height=10, paddle_height=4, max_score=2))
+
+    def test_reset_centers_paddles_and_ball(self) -> None:
+        self.assertEqual(self.game.left_paddle.y, 3)
+        self.assertEqual(self.game.right_paddle.y, 3)
+        self.assertEqual(
+            self.game.ball,
+            Ball(x=10, y=5, dx=1, dy=-1),
+        )
+
+    def test_paddles_are_clamped_to_the_board(self) -> None:
+        self.game.move_paddle("left", -100)
+        self.assertEqual(self.game.left_paddle.y, 0)
+        self.game.move_paddle("right", 100)
+        self.assertEqual(self.game.right_paddle.y, 6)
+
+    def test_paddle_reverses_ball_direction(self) -> None:
+        self.game.ball = Ball(x=2, y=4, dx=-1, dy=0)
+        self.game.update()
+        self.assertEqual(self.game.ball.x, 1)
+        self.assertEqual(self.game.ball.dx, 1)
+
+    def test_ball_bounces_from_top_and_bottom(self) -> None:
+        self.game.ball = Ball(x=10, y=0, dx=1, dy=-1)
+        self.game.update()
+        self.assertEqual(self.game.ball.y, 1)
+        self.assertEqual(self.game.ball.dy, 1)
+
+        self.game.ball = Ball(x=10, y=9, dx=1, dy=1)
+        self.game.update()
+        self.assertEqual(self.game.ball.y, 8)
+        self.assertEqual(self.game.ball.dy, -1)
+
+    def test_missing_right_paddle_scores_for_left(self) -> None:
+        self.game.ball = Ball(x=18, y=0, dx=1, dy=0)
+        self.assertIsNone(self.game.update())
+        self.assertEqual(self.game.update(), "left")
+        self.assertEqual(self.game.left_score, 1)
+        self.assertEqual(self.game.ball.dx, -1)
+
+    def test_winning_score_ends_the_game(self) -> None:
+        self.game.ball = Ball(x=1, y=0, dx=-1, dy=0)
+        self.assertIsNone(self.game.update())
+        self.assertEqual(self.game.update(), "right")
+        self.game.ball = Ball(x=1, y=0, dx=-1, dy=0)
+        self.assertIsNone(self.game.update())
+        self.assertEqual(self.game.update(), "right")
+        self.assertTrue(self.game.game_over)
+        self.assertEqual(self.game.winner, "right")
+        self.assertIsNone(self.game.update())
+
+    def test_render_contains_board_score_and_controls(self) -> None:
+        rendered = self.game.render()
+        self.assertIn("Left: 0", rendered)
+        self.assertIn("Right: 0", rendered)
+        self.assertIn("O", rendered)
+        self.assertIn("W/S: left paddle", rendered)
+        self.assertEqual(len(rendered.splitlines()), self.game.config.height + 4)
+
+
+if __name__ == "__main__":
+    unittest.main()
